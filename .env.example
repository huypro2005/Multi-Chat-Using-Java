# PostgreSQL — backend Docker kết nối Postgres trên máy host (local)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=chatapp
DB_USER=postgres
DB_PASSWORD={YOUR_DB_PASSWORD}

# Legacy alias (optional, dùng khi chạy profile docker-db)
POSTGRES_PASSWORD={YOUR_DB_PASSWORD}

# JWT signing secret — tối thiểu 256 bit, dùng chuỗi ngẫu nhiên
# PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=change-this-to-a-random-256-bit-secret

# Firebase Admin SDK — file JSON trên máy host (mount vào backend container)
FIREBASE_CREDENTIALS_HOST_PATH={PATH_TO_FIREBASE_ADMIN_SDK_JSON}

# Lấy từ Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY={YOUR_FIREBASE_API_KEY}
VITE_FIREBASE_AUTH_DOMAIN={YOUR_FIREBASE_AUTH_DOMAIN}
VITE_FIREBASE_PROJECT_ID={YOUR_FIREBASE_PROJECT_ID}
