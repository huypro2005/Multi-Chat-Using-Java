# ══════════════════════════════════════════════════════════
# Firebase (cho /api/auth/oauth ở tuần 2)
# ══════════════════════════════════════════════════════════
FIREBASE_CREDENTIALS_PATH={YOUR_FIREBASE_CREDENTIALS_PATH}

# ══════════════════════════════════════════════════════════
# PostgreSQL (chỉ dùng cho dev local, Docker container)
# ══════════════════════════════════════════════════════════
DB_HOST={YOUR_DB_HOST}
DB_PORT={YOUR_DB_PORT}
DB_NAME={YOUR_DB_NAME}
DB_USER={YOUR_DB_USER}
DB_PASSWORD={YOUR_DB_PASSWORD}

# ══════════════════════════════════════════════════════════
# Redis (dev local, Docker container)
# ══════════════════════════════════════════════════════════
REDIS_HOST={YOUR_REDIS_HOST}
REDIS_PORT={YOUR_REDIS_PORT}

# ══════════════════════════════════════════════════════════
# JWT
# ══════════════════════════════════════════════════════════
JWT_SECRET={YOUR_JWT_SECRET}
JWT_ACCESS_EXPIRY_MINUTES={YOUR_JWT_ACCESS_EXPIRY_MINUTES}
JWT_REFRESH_EXPIRY_DAYS={YOUR_JWT_REFRESH_EXPIRY_DAYS}

# ══════════════════════════════════════════════════════════
# CORS (cho FE gọi BE trong dev)
# ══════════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS={YOUR_CORS_ALLOWED_ORIGINS}