VITE_API_URL=/api

# Firebase config — lấy từ Firebase Console → Project Settings → Your apps → Web app → firebaseConfig
# Thay thế các giá trị placeholder bằng config thật trước khi chạy Google OAuth
VITE_FIREBASE_API_KEY={YOUR_FIREBASE_API_KEY}
VITE_FIREBASE_AUTH_DOMAIN={YOUR_FIREBASE_AUTH_DOMAIN}
VITE_FIREBASE_PROJECT_ID={YOUR_FIREBASE_PROJECT_ID}